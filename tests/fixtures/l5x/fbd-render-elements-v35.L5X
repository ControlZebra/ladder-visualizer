<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="FBDRenderElements" TargetType="Program" ContainsContext="true" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies">
  <Controller Use="Context" Name="FixtureController" ProcessorType="1756-L85E">
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="ValveAOI" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false">
        <Parameters>
          <Parameter Name="Command" TagType="Base" DataType="BOOL" Usage="Input" Required="true" Visible="true" />
          <Parameter Name="State" TagType="Base" DataType="DINT" Usage="InOut" Required="true" Visible="true" />
          <Parameter Name="Feedback" TagType="Base" DataType="BOOL" Usage="Input" Required="false" Visible="true" />
          <Parameter Name="Running" TagType="Base" DataType="BOOL" Usage="Output" Required="false" Visible="true" />
        </Parameters>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
    <Programs>
      <Program Name="FBDRenderElements">
        <Routines>
          <Routine Name="Elements" Type="FBD">
            <FBDContent SheetSize="D - 22 x 34 in" SheetOrientation="Landscape">
              <Sheet Number="1">
                <IRef ID="1" X="20" Y="40" Operand="FlowCommand" />
                <IRef ID="2" X="20" Y="120" Operand="FlowFeedback" />
                <ORef ID="5" X="720" Y="40" Operand="ValveRunning" />
                <Block Type="ADD" ID="3" X="220" Y="40" />
                <AddOnInstruction Name="ValveAOI" ID="4" X="460" Y="40" Operand="Valve_01" VisiblePins="Command Feedback Running">
                  <InOutParameter Name="State" Argument="ValveState" />
                </AddOnInstruction>
                <GSV ID="9" X="20" Y="420" Object="WallClockTime" />
                <JSR ID="6" X="20" Y="250" Routine="ChildRoutine" In="InputA InputB" Ret="ReturnA ReturnB" />
                <SBR ID="7" X="260" Y="250" Routine="ChildRoutine" Ret="InputA InputB" />
                <RET ID="8" X="500" Y="250" Routine="ChildRoutine" In="ReturnA ReturnB" />
                <Wire FromID="1" ToID="3" ToParam="SourceA" />
                <Wire FromID="2" ToID="3" ToParam="SourceB" />
                <Wire FromID="3" FromParam="Dest" ToID="4" ToParam="Command" />
                <Wire FromID="2" ToID="4" ToParam="Feedback" />
                <Wire FromID="4" FromParam="Running" ToID="5" />
                <TextBox ID="10" X="260" Y="420" Width="260">
                  <Text><![CDATA[Operator note attached to the valve control instruction and wrapped to the declared width.]]></Text>
                </TextBox>
                <Attachment FromID="10" ToID="4" />
              </Sheet>
            </FBDContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
  </Controller>
</RSLogix5000Content>
